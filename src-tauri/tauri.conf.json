{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVO",
  "version": "1.1.0",
  "identifier": "com.evo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EVO",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/evo-bridge"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0NDA4QkFDOTMxRTQzQzgKUldUSVF4NlRySXRBVkJkMHZ2SDF4ZnFTd3Z5MGdSZDQ4QnFqZUZySFhxMFc2cENMTjNJVlN2bzQK",
      "endpoints": [
        "https://github.com/seven0070/evo-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}